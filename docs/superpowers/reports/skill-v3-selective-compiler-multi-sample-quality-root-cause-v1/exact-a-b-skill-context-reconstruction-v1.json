    "a_hard_rule_extract": [
      {
        "rule_id": "MOTIVE_ACTION",
        "text": "Link formative pressure to present want and concealed need; externalize conflict through opposed tactics, costly choice, observable reaction, and next-beat consequence; never name labels.",
        "text_sha256": "c9ddb92a628fe1d4943ab727f9b0a120fb8533f64aa588eda03ad9796682db9c"
      },
      {
        "rule_id": "VOICE_RELATION",
        "text": "Sustain distinct voice through diction, rhythm, evasion, gesture, and withheld explanation; make relationship pressure change tactics, costs, trust, and available action.",
        "text_sha256": "7c0ad85841a7e5bc904d5126df1583aa809e75b41ef6fb3cf2811906b9b4936f"
      },
      {
        "rule_id": "CAUSAL_AFFORDANCE",
        "text": "Select a small number of concrete sensory or mechanical affordances that constrain action, can be interacted with, and can carry a later payoff.",
        "text_sha256": "0a7c19cb5c7474af1c9c9098573965a6fda93ce3ec1fd12a03ab75dd5d28541d"
      },
      {
        "rule_id": "PRESSURE_BEATS",
        "text": "Realize escalation as opposed tactics, obstacle, reaction, and reversal rather than explanatory summary.",
        "text_sha256": "1336342b98c96d8a382e116eaf2ff92ceefc3ab89524786eae484be375c15db7"
      },
      {
        "rule_id": "SETUP_PAYOFF",
        "text": "Plant a concrete question or affordance, preserve its dependency, and pay it off through later action inside the bounded event.",
        "text_sha256": "44d9f7a76835de0148006a0f4b37b673f41748f13f014d89dea958989d8c0680"
      },
      {
        "rule_id": "FRAME_BRIDGE",
        "text": "When confirmed values exist, bridge premise, theme, tone, genre, POV, and tense without guessing or asking questions.",
        "text_sha256": "429e48b691cb5b8d24e6b7bdbecb4cc577e18eaeec0116bc3709ddf3eebf8580"
      },
      {
        "rule_id": "DRAFT_SCENE",
        "text": "Build a continuous Draft-usable microchain: spatial stimulus, opposed action, reaction, resistance, reversal, costly choice, and terminal image; replace interpretive summary with behavior.",
        "text_sha256": "b9c6b7c95d00190b43f43bf176ae052cdc2af079bdadc316a884ab2b0e859941"
      },
      {
        "rule_id": "ANTI_TAXONOMY",
        "text": "Keep labels in reasoning only; replace abstractions about wants, needs, instincts, strain, or local change with choice, dialogue, evasion, gesture, or consequence.",
        "text_sha256": "1e4fe91f4d6ef0c151d81aaa85914c2186577603628dc0d556714fb9dd74e08f"
      }
    ],
