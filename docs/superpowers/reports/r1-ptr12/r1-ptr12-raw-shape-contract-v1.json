{
  "schema": "ProviderRawShapeObservationV1",
  "version": 1,
  "canonicalization": "phase0-canonical-json-v1",
  "authority": "non_authoritative_observation",
  "behavior_effect": "none",
  "fields": {
    "observation_version": {"type":"literal","value":1},
    "correlation_id": {"type":"string","source":"ModelDiagnosticContextV1.inner_attempt_id","sensitive":false},
    "external_call_number": {"type":"integer|null","source":"existing Canary BoundaryRequest.ordinal","minimum":1},
    "run_sha256": {"type":"sha256"},
    "stage": {"type":"controlled_enum"},
    "boundary": {"type":"controlled_enum_or_hash"},
    "contract_id": {"type":"controlled_identifier_or_hash"},
    "contract_version": {"type":"controlled_identifier_or_hash"},
    "schema_sha256": {"type":"sha256|null"},
    "provider_fingerprint": {"type":"sha256"},
    "model_fingerprint": {"type":"sha256"},
    "route_fingerprint": {"type":"sha256"},
    "route_kind": {"type":"enum","values":["primary","configured_fallback","other"]},
    "request_mode": {"type":"enum","values":["plain","structured","tool","unknown"]},
    "outer_retry_ordinal": {"type":"integer","minimum":1},
    "runtime_instance_ordinal": {"type":"integer","minimum":1},
    "inner_attempt_ordinal": {"type":"integer","minimum":1},
    "observation_point": {"type":"enum","values":["transport_body_pre_normalization","stream_event_shape_pre_aggregation"]},
    "provider_protocol": {"type":"enum","values":["anthropic","openai-chat","openai-responses","unknown"]},
    "raw_response_class": {"type":"controlled_enum","values":["response_body","stream_event_sequence","unknown"]},
    "unknown_response_class_sha256": {"type":"sha256|null","note":"hash of class/type name only; never response bytes"},
    "raw_block_count": {"type":"integer","minimum":0},
    "raw_block_type_sequence": {"type":"array<controlled_enum>","maximum_items":128},
    "raw_block_type_sequence_sha256": {"type":"sha256","note":"digest of controlled structural metadata only"},
    "raw_block_type_multiset": {"type":"map<controlled_enum,integer>"},
    "sequence_omitted_after_limit": {"type":"boolean"},
    "reasoning_block_count": {"type":"integer","minimum":0},
    "text_or_final_block_count": {"type":"integer","minimum":0},
    "tool_block_count": {"type":"integer","minimum":0},
    "unknown_block_count": {"type":"integer","minimum":0},
    "unknown_block_type_hashes": {"type":"array<sha256>","maximum_items":32},
    "raw_visible_char_count": {"type":"integer|null","minimum":0,"note":"sum len() over already-present text/delta strings; values are never copied or hashed"},
    "raw_visible_chars_zero": {"type":"boolean|null"},
    "raw_final_text_present": {"type":"boolean|null"},
    "raw_tool_call_present": {"type":"boolean|null"},
    "finish_reason_raw_class": {"type":"controlled_enum","values":["stop","end_turn","length","max_tokens","max_output_tokens","completed","incomplete","failed","cancelled","missing","unknown"]},
    "finish_reason_unknown_sha256": {"type":"sha256|null","note":"hash of unknown reason token only"},
    "output_token_count": {"type":"integer|null","minimum":0},
    "requested_output_cap": {"type":"integer|null","minimum":1},
    "effective_output_cap": {"type":"integer|null","minimum":1},
    "transport_complete": {"type":"boolean|null"},
    "capture_completeness": {"type":"enum","values":["exact","partial","unavailable"]},
    "raw_shape_fingerprint": {"type":"sha256","note":"metadata-only canonical digest"},
    "content_omitted": {"type":"literal","value":true},
    "reasoning_content_omitted": {"type":"literal","value":true},
    "tool_arguments_omitted": {"type":"literal","value":true}
  },
  "controlled_block_types": ["reasoning","thinking","redacted_thinking","text","output_text","message","tool_use","tool_call","function_call","unknown"],
  "capture_algorithm": {
    "time": "O(number_of_blocks + number_of_stream_events)",
    "content_bytes_hashed": 0,
    "large_payload_copy": false,
    "stream_text_handling": "sum lengths as deltas arrive; never concatenate for the observer",
    "sequence_bound": 128,
    "unknown_hash_bound": 32,
    "over_bound_behavior": "retain counts and streaming metadata digest, set sequence_omitted_after_limit=true and capture_completeness=partial"
  },
  "forbidden_fields": ["prompt","system_prompt","user_prompt","story","manuscript","canon","story_state","raw_text","final_text","reasoning_content","thinking_content","tool_arguments","tool_results","provider_response","request_body","response_body","api_key","authorization_header","credential","secret_query_parameter","raw_request_id"],
  "capture_transport": "execution-local metadata slot opened and reset by ModelGateway; no ModelResponse or parser-input mutation",
  "persistence": "ModelGateway emits the immutable pre-normalization receipt through existing ReliabilityTraceEnvelopeV1 after adapter return, or best-effort before re-raising the exact adapter exception",
  "observer_failure_behavior": "FAIL_OPEN"
}
