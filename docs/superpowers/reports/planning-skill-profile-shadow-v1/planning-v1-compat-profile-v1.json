        "skill-section-03cbcb28a0eea7cc996d13a029cc13a7"
      ],
      "text": "Propose concrete sensory and interactive location details that remain local to event realization."
    },
    {
      "authority_level": 7,
      "classification": "advisory_creative",
      "coverage_categories": [
        "world_cost_limit"
