        "skill-section-e8d95199278c0b2a10e3d8b44a53b078"
      ],
      "text": "Choose and adapt a structure to the story; structure models are guides rather than immutable formulas."
    },
    {
      "authority_level": 7,
      "classification": "advisory_creative",
      "coverage_categories": [
        "causal_intent",
        "escalation"
      ],
      "owner": "model_creative",
      "rule_id": "PLOT_CAUSAL_ESCALATION",
      "schema": "ProfileRuleV1",
      "skill_id": "plot-structure",
      "source_section_ids": [
        "skill-section-dd70ef5969bc704145e0d1d93526c746",
        "skill-section-3f71814d5aabcec21bc010f72facb63f",
        "skill-section-d628d71346dec5ca3f61825000ee6ecc",
        "skill-section-46cddd095359b4ab27d2e79e368d7550"
      ],
      "text": "Within the frozen event role, realize actor choice and action, causal escalation, and the resulting local state change toward resolution."
    },
    {
      "authority_level": 7,
      "classification": "advisory_creative",
      "coverage_categories": [
        "setup_payoff"
      ],
      "owner": "model_creative",
      "rule_id": "PLOT_SETUP_PAYOFF_INTENT",
      "schema": "ProfileRuleV1",
      "skill_id": "plot-structure",
      "source_section_ids": [
        "skill-section-b315701d5f0ecb5aef9b50c3254ddbd1",
        "skill-section-6ac17c823afd4a0fd2c65cc3aef67266",
        "skill-section-7aad757ba8a5b31d0f0bdc929a488451",
        "skill-section-2c0fe21bd64d8f639cb956f61386052a",
        "skill-section-15c5c641d451278a63c03f887551a545",
        "skill-section-5a96b50399298ee1443800cef740295c"
      ],
      "text": "Preserve deliberate setup, question, foreshadowing, and payoff intent across the plan."
    },
    {
      "authority_level": 7,
      "classification": "advisory_creative",
      "coverage_categories": [
        "pacing_intent"
      ],
      "owner": "model_creative",
      "rule_id": "PLOT_PACING_INTENT",
      "schema": "ProfileRuleV1",
      "skill_id": "plot-structure",
      "source_section_ids": [
        "skill-section-da6072142c2e77d5666c850b854b3f3f"
      ],
      "text": "Pace action and progression under the frozen formal event role without changing formal chronology or ownership."
    },
    {
      "authority_level": 7,
      "classification": "advisory_creative",
      "coverage_categories": [
        "motivation",
        "relevant_biography"
      ],
      "owner": "model_creative",
      "rule_id": "CHARACTER_MOTIVATION",
      "schema": "ProfileRuleV1",
