      "skill_id": "character-management",
      "source_section_ids": [
        "skill-section-e3fe2fae772fc3d97eb39643fb3b975c",
        "skill-section-05e6b3956b79f0be030549f169fe6dee"
      ],
      "text": "Keep vocabulary, sentence shape, verbal habits, and tone distinct for referenced actors."
    },
    {
      "authority_level": 7,
      "classification": "advisory_creative",
      "coverage_categories": [
        "character_arc"
      ],
      "owner": "model_creative",
      "rule_id": "CHARACTER_ARC",
      "schema": "ProfileRuleV1",
      "skill_id": "character-management",
      "source_section_ids": [
        "skill-section-e3fe2fae772fc3d97eb39643fb3b975c",
        "skill-section-e0f2ac72a95ad6c4bf03dca1cd4e3f7f"
      ],
      "text": "Connect starting state, turning points, and ending state without overriding frozen event outcomes."
    },
    {
      "authority_level": 7,
      "classification": "advisory_creative",
      "coverage_categories": [
        "relationship_nuance"
      ],
      "owner": "model_creative",
      "rule_id": "CHARACTER_RELATIONSHIP_NUANCE",
      "schema": "ProfileRuleV1",
      "skill_id": "character-management",
      "source_section_ids": [
