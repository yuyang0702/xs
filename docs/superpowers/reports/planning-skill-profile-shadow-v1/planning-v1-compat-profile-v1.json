      "source_section_ids": [
        "skill-section-e3fe2fae772fc3d97eb39643fb3b975c",
        "skill-section-17042a304f1d005b02b918a38708b4b3",
        "skill-section-30c4b9e7a010a05a63f55cfd7cc2390c"
      ],
      "text": "Realize external wants, internal needs, relevant biography, formative pressures, and their conflict in character action."
    },
    {
      "authority_level": 7,
      "classification": "advisory_creative",
      "coverage_categories": [
        "voice"
      ],
      "owner": "model_creative",
      "rule_id": "CHARACTER_VOICE",
