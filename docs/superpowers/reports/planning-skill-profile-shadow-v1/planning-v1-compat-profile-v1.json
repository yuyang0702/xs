        "skill-section-ccadce381855ca07b3b0db5e0beaa73e",
        "skill-section-1ca9422fd531a74e0c7c58b15e01dad8"
      ],
      "text": "Use the referenced relationship role to shape pressure, contrast, trust, and subtext without inventing authority."
    },
    {
      "authority_level": 7,
      "classification": "advisory_creative",
      "coverage_categories": [
        "sensory_specificity",
